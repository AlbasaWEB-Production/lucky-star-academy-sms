# ============================================================================
# Lucky Star Academy SMS - environment template
# ============================================================================
# Copy this file to `.env.local` and fill in the values:
#
#     cd web
#     cp .env.example .env.local
#
# .env.local is gitignored. Never commit real keys.
# ============================================================================


# ---------------------------------------------------------------------------
# Required - public (safe to expose to the browser)
# ---------------------------------------------------------------------------
# Supabase Dashboard -> your project -> Connect (or Settings -> API).
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time, so
# changing them requires a rebuild/restart of the dev server.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The publishable / anon key. Safe in the browser: every query it makes is
# still filtered by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY


# ---------------------------------------------------------------------------
# Required on the server only - NEVER prefix these with NEXT_PUBLIC_
# ---------------------------------------------------------------------------
# This key BYPASSES Row Level Security. It is used only in server code
# (src/lib/supabase/admin.ts, which imports "server-only") for:
#   - creating and deleting auth users
#   - writing app_metadata, which is where roles and school ids live
#   - the pre-login student lookup, which runs before a session exists
#
# Supabase Dashboard -> Settings -> API keys -> secret key (sb_secret_...).
# The legacy `service_role` JWT also works, via SUPABASE_SERVICE_ROLE_KEY.

SUPABASE_SECRET_KEY=YOUR-SECRET-KEY


# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Domain used to synthesise the login address for students, who sign in with a
# roll number and name rather than an email. The app builds addresses like
# `lucky-star-academy+12@students.example.com`. These addresses never receive
# mail, so any domain works; point it at a domain you control if you would
# rather not use the placeholder default.

# STUDENT_EMAIL_DOMAIN=students.example.com


# ---------------------------------------------------------------------------
# Optional - the public website / portal host split
# ---------------------------------------------------------------------------
# The app serves two things: the school's public website, and the school
# management system. On the real domain they live on separate hostnames:
#
#     luckystaracademy.edu.gh        -> the public website
#     www.luckystaracademy.edu.gh    -> the public website
#     portal.luckystaracademy.edu.gh -> the management system and sign-in
#
# Setting NEXT_PUBLIC_PORTAL_HOST is what switches that split on. While it is
# unset - local development, and every Vercel preview deployment - the app
# behaves as a single hostname: the website is at `/` and the portal is at
# `/login`, `/admin`, `/teacher`, and so on, exactly as before.
#
# Because these are NEXT_PUBLIC_ values they are inlined at build time, so
# changing them requires a rebuild. Leave both commented out locally; set both
# in the production environment only, once the domain is registered.
#
# See SITE.md for the routing rules and PLACEHOLDERS.md for the domain
# registration checklist.

# NEXT_PUBLIC_SITE_HOST=luckystaracademy.edu.gh
# NEXT_PUBLIC_PORTAL_HOST=portal.luckystaracademy.edu.gh
